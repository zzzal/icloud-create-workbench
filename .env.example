# 启动时如果没有 .env，会按这份结构自动生成，并填入管理员密码和密钥。
# 已有 .env 不会被覆盖。不要把 .env 提交到仓库。
NODE_ENV=development
TZ=Asia/Shanghai
HOST=127.0.0.1
PORT=4173

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=
COOKIE_SECURE=false

DATA_ENCRYPTION_KEY=
DATABASE_PATH=./data/workbench.db

GENERATION_BATCH_LIMIT=5
GENERATION_COOLDOWN_MINUTES=60
GENERATION_TARGET_DEFAULT=100
GENERATION_ACCOUNT_LIMIT=700
GENERATION_RETRY_MINUTES=5

ICLOUD_CLIENT_BUILD=2642Build23
ICLOUD_CLIENT_MASTERING=2642Build23
